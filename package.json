{
  "name": "tabproof",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "node --env-file-if-exists=.env scripts/serve.mjs",
    "test": "node --test test/*.test.mjs",
    "check:fixtures": "node scripts/check-fixtures.mjs",
    "check:evidence": "node scripts/check-evidence.mjs",
    "check:regressions": "node scripts/check-regressions.mjs",
    "check:stopping": "node scripts/check-stopping.mjs",
    "check:console": "node scripts/check-console.mjs",
    "check:custom": "node scripts/check-custom.mjs",
    "check:public-run": "node scripts/check-public-run.mjs",
    "check:third-party": "node scripts/check-react-aria-scroll.mjs",
    "check:third-party:agent": "node --env-file=.env scripts/check-react-aria-agent.mjs",
    "demo:third-party": "node scripts/serve-react-aria-demo.mjs",
    "check:benchmark-replays": "node scripts/check-benchmark-replays.mjs",
    "compare": "node scripts/compare-runs.mjs",
    "agent": "node --env-file=.env scripts/run-agent.mjs",
    "benchmark": "node scripts/benchmark.mjs"
  },
  "dependencies": {
    "playwright": "^1.64.1"
  }
}
